{
  "functions": [{
    "source": "functions",
    "codebase": "haa",
    "runtime": "python312",
    "ignore": ["venv", ".venv", "__pycache__", "*.pyc", ".env.example"]
  }],
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/api/**", "function": {"functionId": "api", "region": "us-central1"}},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]},
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]},
      {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {"rules": "firestore.rules", "indexes": "firestore.indexes.json"},
  "emulators": {
    "auth": {"port": 9099}, "functions": {"port": 5001},
    "firestore": {"port": 8080}, "hosting": {"port": 5000},
    "ui": {"enabled": true}, "singleProjectMode": true
  }
}
