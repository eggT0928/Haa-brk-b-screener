rules_version = '2';
// pension-v2: 선택 cashBalance(원, 0~1e12). 별도 12종목 프로필. 금 개별 weights는 0, goldTargetWeight와 나머지 합은 100%.
// v2 이력은 실행 시 유효 비중 합100%와 고정순서 [held,price,target] × 12인 36개 숫자. v1 이력 순서는 유지.
// 데이터 모델: access/{caller}는 서버 발급 enabled/ownerUid/role이며 본인 읽기만 가능하다.
// users/{ownerUid}: HAA holdings12/cash/sp500/기간/updatedAt + 선택 quantityMode(구문서 정수).
// portfolios/sujin: 수진 고정비중 설정. portfolios/pension: magic-pension-v1/KRW,
// totalBalance/principal 0~1e12, holdings9 정수, weights9 합100%, targetOverrides9 null/정수.
// 설정의 updatedAt와 이력의 createdAt는 서버시각. 모든 계산안은 공유 구성원 추가·읽기만 허용한다.
// 연금 이력: month, strategy/currency/kind, equity/principal/remainingCash, weights9,
// 가격 ISO시각2개와 고정순서9개 행(held/price/target). 종목은 전략 고정순서, 매매는 target-held로 복원한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function approved() {
      return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.enabled == true;
    }
    function owner(uid) {
      // 서버가 발급한 공유 대상만 허용한다. URL·프로필 필드로 다른 가족 경로를 선택할 수 없다.
      let grant = get(/databases/$(database)/documents/access/$(request.auth.uid)).data;
      return approved() && grant.get('ownerUid', request.auth.uid) == uid;
    }
    function amount(n) { return n is number && n >= 0 && n <= 1000000000000; }
    function quantity(n) { return n is number && n >= 0 && n <= 1000000000; }
    function validHoldings(h) {
      return h is map && h.keys().hasOnly(['SPY','SPYM','VEA','VWO','IWM','BIL','IEF','TLT','TIP','PDBC','VNQ','BRK-B'])
        && h.keys().hasAll(['SPY','SPYM','VEA','VWO','IWM','BIL','IEF','TLT','TIP','PDBC','VNQ','BRK-B'])
        && quantity(h.SPY) && quantity(h.SPYM) && quantity(h.VEA) && quantity(h.VWO)
        && quantity(h.IWM) && quantity(h.BIL) && quantity(h.IEF) && quantity(h.TLT)
        && quantity(h.TIP) && quantity(h.PDBC) && quantity(h.VNQ) && quantity(h['BRK-B']);
    }
    function dateText(s) { return s is string && (s == '' || s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function validSujinHoldings(h) {
      return h is map && h.keys().hasOnly(['QQQM','SPY','SPYM','JEPQ','BRK-B','IEF','TLT','GLD','PDBC'])
        && h.keys().hasAll(['QQQM','SPY','SPYM','JEPQ','BRK-B','IEF','TLT','GLD','PDBC'])
        && quantity(h.QQQM) && quantity(h.SPY) && quantity(h.SPYM) && quantity(h.JEPQ)
        && quantity(h['BRK-B']) && quantity(h.IEF) && quantity(h.TLT) && quantity(h.GLD) && quantity(h.PDBC);
    }
    function sujinLine(l, ticker) {
      let held = l.held;
      let target = l.target;
      let price = l.price;
      let trade = l.trade;
      // 이력에는 화면에서 사용하는 5개 필드만 저장한다. 모든 행의 수량·가격을 검사한다.
      return l.keys().hasOnly(['ticker','held','price','target','trade'])
        && l.ticker == ticker && held >= 0 && held <= 1000000000 && target >= 0 && target <= 1000000000
        && price > 0 && price <= 1000000000000 && math.abs(trade) <= 1000000000;
    }
    function priceTime(s) { return s is string && s.size() <= 40 && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$'); }
    // 지역 변수로 문서 경로의 반복 평가를 줄여 규칙의 표현식 한도 안에서 모든 행을 검사한다.
    function validSujinRecord(d) {
      let lines = d.lines;
      return d.keys().hasOnly(['createdAt','month','strategy','kind','equity','remainingCash','priceUpdatedAt','oldestPriceAt','quantityMode','lines'])
        && d.createdAt == request.time && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && d.strategy == 'sujin-fixed-v1' && d.kind == '계산안'
        && amount(d.equity) && amount(d.remainingCash) && d.remainingCash <= d.equity
        && priceTime(d.priceUpdatedAt) && priceTime(d.oldestPriceAt)
        && d.quantityMode in ['fractional','whole']
        && lines is list && lines.size() == 9
        && sujinLine(lines[0], 'QQQM') && sujinLine(lines[1], 'SPY')
        && sujinLine(lines[2], 'SPYM') && sujinLine(lines[3], 'JEPQ')
        && sujinLine(lines[4], 'BRK-B') && sujinLine(lines[5], 'IEF')
        && sujinLine(lines[6], 'TLT') && sujinLine(lines[7], 'GLD')
        && sujinLine(lines[8], 'PDBC');
    }
    function optionalQuantityMode(d) { return !('quantityMode' in d) || d.quantityMode in ['whole','fractional']; }
    function validHaaProfile(d) {
      return d.keys().hasOnly(['holdings','cash','sp500','quantityMode','backtestStart','backtestEnd','updatedAt'])
        && validHoldings(d.holdings) && amount(d.cash) && d.sp500 in ['SPY','SPYM']
        && optionalQuantityMode(d) && dateText(d.backtestStart) && dateText(d.backtestEnd)
        && d.updatedAt == request.time;
    }
    function pensionMap(m) {
      let codes = ['379800','294400','283580','453810','411060','385560','308620','453850','449170'];
      return m is map && m.keys().hasOnly(codes) && m.keys().hasAll(codes);
    }
    function whole(n) { return n is int && n >= 0 && n <= 1000000000; }
    function nullableWhole(n) { return n == null || whole(n); }
    function pensionHoldings(h) {
      return pensionMap(h) && whole(h['379800']) && whole(h['294400']) && whole(h['283580'])
        && whole(h['453810']) && whole(h['411060']) && whole(h['385560'])
        && whole(h['308620']) && whole(h['453850']) && whole(h['449170']);
    }
    function pensionOverrides(h) {
      return pensionMap(h) && nullableWhole(h['379800']) && nullableWhole(h['294400']) && nullableWhole(h['283580'])
        && nullableWhole(h['453810']) && nullableWhole(h['411060']) && nullableWhole(h['385560'])
        && nullableWhole(h['308620']) && nullableWhole(h['453850']) && nullableWhole(h['449170']);
    }
    function pensionWeights(w) {
      // 반복 필드 참조와 함수 호출을 줄여 9개 이력 행을 모두 검증해도 평가 한도 안에 둔다.
      let a=w['379800']; let b=w['294400']; let c=w['283580'];
      let d=w['453810']; let e=w['411060']; let f=w['385560'];
      let g=w['308620']; let h=w['453850']; let i=w['449170'];
      return pensionMap(w) && a>=0 && a<=1 && b>=0 && b<=1 && c>=0 && c<=1
        && d>=0 && d<=1 && e>=0 && e<=1 && f>=0 && f<=1
        && g>=0 && g<=1 && h>=0 && h<=1 && i>=0 && i<=1
        && math.abs(a+b+c+d+e+f+g+h+i-1) < 0.00000001;
    }
    function validPensionProfile(d) {
      return d.keys().hasOnly(['strategy','currency','totalBalance','principal','holdings','weights','targetOverrides','updatedAt'])
        && d.strategy == 'magic-pension-v1' && d.currency == 'KRW'
        && amount(d.totalBalance) && amount(d.principal)
        && pensionHoldings(d.holdings) && pensionWeights(d.weights) && pensionOverrides(d.targetOverrides)
        && d.updatedAt == request.time;
    }
    function pensionLine(l) {
      let held=l.held;
      let target=l.target;
      let price=l.price;
      // 필수 3개 필드를 모두 참조하고 개수를 고정한다. 종목과 매매량은 중복 저장하지 않는다.
      return l.size()==3
        && held is int && held>=0 && held<=1000000000 && target is int && target>=0 && target<=1000000000
        && price>0 && price<=1000000000000;
    }
    function validPensionRecord(d) {
      let lines=d.lines;
      return d.keys().hasOnly(['createdAt','month','strategy','currency','kind','equity','principal','remainingCash','weights','priceUpdatedAt','oldestPriceAt','lines'])
        && d.createdAt==request.time && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && d.strategy=='magic-pension-v1' && d.currency=='KRW' && d.kind=='계산안'
        && amount(d.equity) && d.equity>0 && amount(d.principal) && amount(d.remainingCash) && d.remainingCash<=d.equity
        && pensionWeights(d.weights) && priceTime(d.priceUpdatedAt) && priceTime(d.oldestPriceAt)
        && lines is list && lines.size()==9
        && pensionLine(lines[0]) && pensionLine(lines[1]) && pensionLine(lines[2])
        && pensionLine(lines[3]) && pensionLine(lines[4]) && pensionLine(lines[5])
        && pensionLine(lines[6]) && pensionLine(lines[7]) && pensionLine(lines[8]);
    }
    function pensionMapV2(m) {
      // All twelve required keys are dereferenced by each caller; size forbids extras.
      return m is map && m.size()==12;
    }
    function pensionHoldingsV2(h) {
      return pensionMapV2(h) && whole(h['379800']) && whole(h['379810']) && whole(h['294400']) && whole(h['283580']) && whole(h['453810']) && whole(h['0072R0']) && whole(h['411060']) && whole(h['148070']) && whole(h['385560']) && whole(h['0085P0']) && whole(h['476760']) && whole(h['469830']);
    }
    function pensionOverridesV2(h) {
      return pensionMapV2(h) && nullableWhole(h['379800']) && nullableWhole(h['379810']) && nullableWhole(h['294400']) && nullableWhole(h['283580']) && nullableWhole(h['453810']) && nullableWhole(h['0072R0']) && nullableWhole(h['411060']) && nullableWhole(h['148070']) && nullableWhole(h['385560']) && nullableWhole(h['0085P0']) && nullableWhole(h['476760']) && nullableWhole(h['469830']);
    }
    function lastWeights(w) {
      let a=w['0085P0']; let b=w['476760']; let c=w['469830'];
      return a>=0 && b>=0 && c>=0 ? a+b+c : -100;
    }
    function pensionWeightsV2(w, extra) {
      let a=w['379800'];
      let b=w['379810'];
      let c=w['294400'];
      let d=w['283580'];
      let e=w['453810'];
      let f=w['0072R0'];
      let g=w['411060'];
      let h=w['148070'];
      let i=w['385560'];
      let j=lastWeights(w);
      return pensionMapV2(w) && a>=0 && b>=0 && c>=0 && d>=0 && e>=0 && f>=0 && g>=0 && h>=0 && i>=0 && j>=0 && math.abs(a+b+c+d+e+f+g+h+i+j+extra-1)<0.00000001;
    }
    function validPensionProfileV2(d) {
      return d.keys().hasOnly(['strategy','currency','totalBalance','principal','holdings','weights','targetOverrides','goldTargetWeight','cashBalance','updatedAt'])
        && (!('cashBalance' in d) || amount(d.cashBalance))
        && d.strategy == 'magic-pension-v2' && d.currency == 'KRW'
        && amount(d.totalBalance) && amount(d.principal)
        && pensionHoldingsV2(d.holdings) && d.goldTargetWeight>=0 && d.goldTargetWeight<=1 && d.weights['0072R0']==0 && d.weights['411060']==0 && pensionWeightsV2(d.weights,d.goldTargetWeight) && pensionOverridesV2(d.targetOverrides)
        && d.updatedAt == request.time;
    }
    function pensionTriple(held,price,target) {
      return held is int && target is int && held>=0 && held<=1000000000
        && target>=0 && target<=1000000000 && price>0 && price<=1000000000000;
    }
    function validPensionRecordV2(d) {
      let lines=d.lines;
      return d.size()==12
        && d.createdAt==request.time && d.month.matches('^[0-9]{4}-[0-9]{2}$')
        && d.strategy=='magic-pension-v2' && d.currency=='KRW' && d.kind=='계산안'
        && amount(d.equity) && d.equity>0 && amount(d.principal) && amount(d.remainingCash) && d.remainingCash<=d.equity
        && pensionWeightsV2(d.weights,0) && priceTime(d.priceUpdatedAt) && priceTime(d.oldestPriceAt)
        && lines is list && lines.size()==36
        && pensionTriple(lines[0],lines[1],lines[2]) && pensionTriple(lines[3],lines[4],lines[5]) && pensionTriple(lines[6],lines[7],lines[8]) && pensionTriple(lines[9],lines[10],lines[11]) && pensionTriple(lines[12],lines[13],lines[14]) && pensionTriple(lines[15],lines[16],lines[17]) && pensionTriple(lines[18],lines[19],lines[20]) && pensionTriple(lines[21],lines[22],lines[23]) && pensionTriple(lines[24],lines[25],lines[26]) && pensionTriple(lines[27],lines[28],lines[29]) && pensionTriple(lines[30],lines[31],lines[32]) && pensionTriple(lines[33],lines[34],lines[35]);
    }
    match /access/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validHaaProfile(request.resource.data);
      allow delete: if owner(uid) && request.auth.uid == uid;
      match /rebalances/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['createdAt','signalMonth','sp500','quantityMode','equity','lines','kind'])
          && optionalQuantityMode(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.signalMonth.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.sp500 in ['SPY','SPYM']
          && amount(request.resource.data.equity)
          && request.resource.data.lines is list && request.resource.data.lines.size() <= 12
          && request.resource.data.kind == '계산안';
        allow update, delete: if false;
      }
      // 현근의 기존 문서는 유지하고 수진만 명시적인 별도 경로에 저장한다.
      match /portfolios/sujin {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['strategy','holdings','totalMode','totalBalance','cash','quantityMode','backtestStart','backtestEnd','updatedAt'])
          && request.resource.data.strategy == 'sujin-fixed-v1'
          && validSujinHoldings(request.resource.data.holdings)
          && request.resource.data.totalMode in ['manual','holdings']
          && amount(request.resource.data.totalBalance) && amount(request.resource.data.cash)
          && request.resource.data.quantityMode in ['fractional','whole']
          && dateText(request.resource.data.backtestStart) && dateText(request.resource.data.backtestEnd)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
        match /rebalances/{id} {
          allow read: if owner(uid);
          allow create: if owner(uid) && validSujinRecord(request.resource.data);
          allow update, delete: if false;
        }
      }
      match /portfolios/pension {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && validPensionProfile(request.resource.data);
        allow delete: if false;
        match /rebalances/{id} {
          allow read: if owner(uid);
          allow create: if owner(uid) && validPensionRecord(request.resource.data);
          allow update, delete: if false;
        }
      }
      match /portfolios/pension-v2 {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && validPensionProfileV2(request.resource.data);
        allow delete: if false;
        match /rebalances/{id} {
          allow read: if owner(uid);
          allow create: if owner(uid) && validPensionRecordV2(request.resource.data);
          allow update, delete: if false;
        }
      }
    }
    match /signals/{id} { allow read: if approved(); allow write: if false; }
    match /signalHistory/{id} { allow read: if approved(); allow write: if false; }
    match /market/{id} { allow read: if approved(); allow write: if false; }
    match /status/{id} { allow read: if approved(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
